# ==========================================================
# KONFIGURASI SUPABASE (OPSIONAL UNTUK PENGUJIAN LOKAL)
# ==========================================================
# Jika variabel ini belum diisi, aplikasi akan otomatis berjalan
# menggunakan penyimpanan lokal (Local Storage) di browser Anda.
#
# Cara mendapatkan kunci Supabase:
# 1. Buka dashboard https://supabase.com
# 2. Masuk ke Project Settings -> API
# 3. Salin Project URL dan anon public key ke file .env.local
# ==========================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
